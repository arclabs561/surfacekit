{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surfacekit:surface-evaluation:v3",
  "title": "surfacekit cross-surface evaluation packet",
  "description": "A portable observation packet for one evaluation scenario: the shared output-recovery-room preset or a caller-owned scenario. This schema admits evidence shape only; it does not assign a product verdict or score.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3,
      "description": "Schema revision for this packet. v2 adds environment_identity and executable_check; v3 adds notes, scenario_claims, caller-owned scenario ids, and requires environment_identity and executable_check on every surface, as the Rust contract already did."
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "description": "The evaluated scenario. output-recovery-room is the shared preset and must state all seven of its claims; any other id is caller-owned."
    },
    "surface": {
      "type": "string",
      "enum": [
        "cli",
        "tui",
        "web"
      ],
      "description": "The product surface observed by this packet."
    },
    "observation": {
      "type": "string",
      "enum": [
        "bounded_subprocess",
        "managed_pty",
        "bounded_playwright"
      ],
      "description": "The authority used to observe the subject; it is not a claim about product behavior."
    },
    "evidence_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "argv",
          "exit_status",
          "stdout_or_artifact",
          "run_record",
          "pty_transcript",
          "key_events",
          "resize_events",
          "browser_events",
          "screenshots",
          "dom_predicates",
          "environment_identity",
          "executable_check"
        ]
      },
      "description": "Kinds of attested evidence retained with the packet. Artifact references themselves stay in the evaluation envelope."
    },
    "recording": {
      "$ref": "#/$defs/recording_metadata",
      "description": "Optional compatibility metadata for the replay that backs this packet. A judge must reject an absent, incomplete, or uninspectable recording; schema admission remains backward compatible for existing v1 packets."
    },
    "claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "output_visible",
          "reference_addressable",
          "interruption_preserved",
          "recovery_without_regeneration",
          "actors_attributed",
          "actor_context_isolated",
          "handoff_is_notice_not_reply"
        ]
      },
      "description": "Preset scenario claims tested by retained evidence. Valid shape does not establish that any claim is true."
    },
    "scenario_claims": {
      "type": "array",
      "uniqueItems": true,
      "description": "Claims a caller-owned scenario tests, namespaced as scope:claim so none can be mistaken for a preset claim.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]*:[a-z0-9][a-z0-9_.-]*$"
      }
    },
    "evidence": {
      "type": "array",
      "description": "Observed artifacts. Declarations may be empty; completeness is a runtime check.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "payload"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "argv",
              "exit_status",
              "stdout_or_artifact",
              "run_record",
              "pty_transcript",
              "key_events",
              "resize_events",
              "browser_events",
              "screenshots",
              "dom_predicates",
              "environment_identity",
              "executable_check"
            ]
          },
          "payload": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "description": "The critic's running notes in the order written. Append-only: a revision is a later note whose revises names an earlier id; ids strictly increase (a runtime check).",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "surface",
    "observation",
    "evidence_kinds",
    "claims"
  ],
  "$defs": {
    "recording_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ],
          "description": "Whether recording reached a complete terminal state."
        },
        "inspectability": {
          "enum": [
            "inspectable",
            "uninspectable"
          ],
          "description": "Whether a judge can inspect the retained source artifacts."
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "retention": {
                "enum": [
                  "durable",
                  "local_private",
                  "remote_redacted",
                  "ephemeral"
                ],
                "description": "Retention boundary for this inspectable artifact reference."
              }
            },
            "required": [
              "ref",
              "retention"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why the recording is incomplete or cannot be inspected."
        }
      },
      "required": [
        "status",
        "inspectability",
        "source_artifacts"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "inspectability": {
                "const": "uninspectable"
              }
            },
            "required": [
              "inspectability"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "cli_requirements": {
      "properties": {
        "observation": {
          "const": "bounded_subprocess"
        },
        "evidence_kinds": {
          "allOf": [
            {
              "contains": {
                "const": "argv"
              }
            },
            {
              "contains": {
                "const": "exit_status"
              }
            },
            {
              "contains": {
                "const": "stdout_or_artifact"
              }
            },
            {
              "contains": {
                "const": "run_record"
              }
            },
            {
              "contains": {
                "const": "environment_identity"
              }
            },
            {
              "contains": {
                "const": "executable_check"
              }
            }
          ]
        }
      }
    },
    "tui_requirements": {
      "properties": {
        "observation": {
          "const": "managed_pty"
        },
        "evidence_kinds": {
          "allOf": [
            {
              "contains": {
                "const": "pty_transcript"
              }
            },
            {
              "contains": {
                "const": "key_events"
              }
            },
            {
              "contains": {
                "const": "resize_events"
              }
            },
            {
              "contains": {
                "const": "run_record"
              }
            },
            {
              "contains": {
                "const": "environment_identity"
              }
            },
            {
              "contains": {
                "const": "executable_check"
              }
            }
          ]
        }
      }
    },
    "web_requirements": {
      "properties": {
        "observation": {
          "const": "bounded_playwright"
        },
        "evidence_kinds": {
          "allOf": [
            {
              "contains": {
                "const": "browser_events"
              }
            },
            {
              "contains": {
                "const": "screenshots"
              }
            },
            {
              "contains": {
                "const": "dom_predicates"
              }
            },
            {
              "contains": {
                "const": "run_record"
              }
            },
            {
              "contains": {
                "const": "environment_identity"
              }
            },
            {
              "contains": {
                "const": "executable_check"
              }
            }
          ]
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "at_ms",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the session started."
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "description": "The actor step the note follows."
        },
        "kind": {
          "enum": [
            "observation",
            "expectation_gap",
            "friction",
            "delight",
            "question"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 400
        },
        "revises": {
          "type": "integer",
          "minimum": 1,
          "description": "An earlier note this one supersedes."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Measured latency of the critic call that wrote the note; absent means not measured."
        },
        "within_budget": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "surface": {
            "const": "cli"
          }
        },
        "required": [
          "surface"
        ]
      },
      "then": {
        "$ref": "#/$defs/cli_requirements"
      }
    },
    {
      "if": {
        "properties": {
          "surface": {
            "const": "tui"
          }
        },
        "required": [
          "surface"
        ]
      },
      "then": {
        "$ref": "#/$defs/tui_requirements"
      }
    },
    {
      "if": {
        "properties": {
          "surface": {
            "const": "web"
          }
        },
        "required": [
          "surface"
        ]
      },
      "then": {
        "$ref": "#/$defs/web_requirements"
      }
    },
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "output-recovery-room"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "allOf": [
              {
                "contains": {
                  "const": "output_visible"
                }
              },
              {
                "contains": {
                  "const": "reference_addressable"
                }
              },
              {
                "contains": {
                  "const": "interruption_preserved"
                }
              },
              {
                "contains": {
                  "const": "recovery_without_regeneration"
                }
              },
              {
                "contains": {
                  "const": "actors_attributed"
                }
              },
              {
                "contains": {
                  "const": "actor_context_isolated"
                }
              },
              {
                "contains": {
                  "const": "handoff_is_notice_not_reply"
                }
              }
            ]
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "properties": {
            "claims": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "scenario_claims"
          ],
          "properties": {
            "scenario_claims": {
              "minItems": 1
            }
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "schema_version": 3,
      "scenario_id": "output-recovery-room",
      "surface": "tui",
      "observation": "managed_pty",
      "evidence_kinds": [
        "environment_identity",
        "executable_check",
        "key_events",
        "pty_transcript",
        "resize_events",
        "run_record"
      ],
      "recording": {
        "status": "complete",
        "inspectability": "inspectable",
        "source_artifacts": [
          {
            "ref": "cast:output-recovery",
            "retention": "local_private"
          }
        ]
      },
      "claims": [
        "output_visible",
        "reference_addressable",
        "interruption_preserved",
        "recovery_without_regeneration",
        "actors_attributed",
        "actor_context_isolated",
        "handoff_is_notice_not_reply"
      ]
    },
    {
      "schema_version": 3,
      "scenario_id": "catalogue-explore/phone-reader",
      "surface": "web",
      "observation": "bounded_playwright",
      "evidence_kinds": [
        "browser_events",
        "screenshots",
        "dom_predicates",
        "run_record",
        "environment_identity",
        "executable_check"
      ],
      "claims": [],
      "scenario_claims": [
        "catalogue:goal_reached"
      ],
      "notes": [
        {
          "id": 1,
          "at_ms": 1200,
          "step": 1,
          "kind": "observation",
          "text": "Home opens on recommendation rows.",
          "latency_ms": 900,
          "within_budget": true
        },
        {
          "id": 2,
          "at_ms": 4100,
          "step": 3,
          "kind": "expectation_gap",
          "text": "Closing the filter sheet dropped the staged tag.",
          "revises": 1
        }
      ]
    }
  ]
}
